# ============================================
# Uni Connect - Root .gitignore
# ============================================

# --- Dependencies / Build output ---
node_modules/
dist/
target/
build/

# --- Logs ---
*.log
logs/

# --- Runtime data (auto-created by the app) ---
uploads/
*.pid
.vite-pid.txt
.server-pid.txt

# --- IDE / Editor ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- OS ---
.DS_Store
Thumbs.db

# --- Environment / Secrets (DO NOT commit real values) ---
.env
.env.local
.env.*.local

# --- Scratch / one-off analysis files ---
cp.txt
field.txt
ur.txt
ur_annotations.txt
mvn-test-output.txt
run-error.log
run-8081-out.log
run-8081-err.log
run-output.log

# --- Local tooling data (Copilot modernize hooks) ---
.github/modernize/

# --- Maven wrapper jar (regenerated automatically) ---
.mvn/wrapper/maven-wrapper.jar
